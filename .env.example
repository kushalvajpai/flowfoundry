# FlowFoundry Environment Variables
# Copy this file to .env.local for local development.
# DO NOT commit .env or .env.local containing real credentials to version control.

# -------------------------------------------------------------
# Internal Dashboard Authentication & Session Security
# -------------------------------------------------------------
# Cryptographic secret key used for signing HMAC-SHA256 session tokens.
# Must be at least 32 characters in production. Never expose to client bundles.
DASHBOARD_SECRET_KEY=change_me_to_a_strong_random_secret_at_least_32_chars_in_prod

# Dashboard Operator Credentials
# Used for administrative access to /dashboard and /dashboard/leads/[id]
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=change_this_to_a_secure_password_in_production

# Admin Deletion & Purge Protection
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_in_production

# -------------------------------------------------------------
# Database Persistence (Supabase / PostgreSQL)
# -------------------------------------------------------------
# Server-side only: Never expose service-role credentials to the browser
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# -------------------------------------------------------------
# Downstream Ingestion & Workflows (n8n & CRM)
# -------------------------------------------------------------
# Server-side only: Never prefix with NEXT_PUBLIC_
N8N_LEAD_WEBHOOK_URL=https://your-n8n-instance.com/webhook/flowfoundry-leads
HUBSPOT_ACCESS_TOKEN=pat-na1-your-hubspot-private-app-token

# -------------------------------------------------------------
# Public Application Configuration
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://flowfoundry.io

# -------------------------------------------------------------
# AI Lead Qualification (OpenAI)
# -------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key

# -------------------------------------------------------------
# Transactional Email (Resend)
# -------------------------------------------------------------
# Server-side only: Never expose RESEND_API_KEY to browser bundles
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=FlowFoundry <onboarding@resend.dev>
FLOWFOUNDRY_SALES_EMAIL=sales@flowfoundry.io
